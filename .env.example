# Public env (safe to commit as documentation only — set real values in Vercel)

# Prefer GTM; load GA4 as a tag inside the container.
NEXT_PUBLIC_GTM_ID=

# Use only when GTM is empty (direct gtag.js).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification content value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional override (defaults to https://berktugberke.com in code).
NEXT_PUBLIC_SITE_URL=https://berktugberke.com

# Gündem kanonik host (defaults to https://haberler.berktugberke.com).
NEXT_PUBLIC_HABERLER_URL=https://haberler.berktugberke.com

# Server-only (Vercel ISR + Cloudflare Worker content-publisher)
REVALIDATE_SECRET=
REVALIDATE_URL=https://berktugberke.com/api/revalidate
INDEXNOW_KEY=bberke2026indexnowkey

# Public JSON base (R2 r2.dev or Worker proxy) — Next.js CONTENT_PUBLIC_BASE_URL on Vercel
CONTENT_PUBLIC_BASE_URL=

# R2 S3 API (local seed/verify + GitHub manual workflows; Worker uses bucket binding)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=portfolio-content

# Legacy (rollback only)
BLOB_PUBLIC_BASE_URL=

# Faz 0 ops (GitHub Actions ops-phase0.yml — optional local prune)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Faz 5 GSC Search Analytics (GitHub secret GSC_SERVICE_ACCOUNT_JSON; Search Console’da SA e-postasına kullanıcı ekleyin)
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=sc-domain:berktugberke.com

# Buttondown subscribe modal username (public).
NEXT_PUBLIC_BUTTONDOWN_USERNAME=berktug
