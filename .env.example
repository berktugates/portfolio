# Public env (safe to commit as documentation only — set real values in Vercel)

# Prefer GTM; load GA4 as a tag inside the container.
NEXT_PUBLIC_GTM_ID=

# Use only when GTM is empty (direct gtag.js).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification content value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional override (defaults to https://berktugberke.com in code).
NEXT_PUBLIC_SITE_URL=https://berktugberke.com

# Buttondown subscribe modal username (public).
NEXT_PUBLIC_BUTTONDOWN_USERNAME=berktug
