{
  "name": "berktug-portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/generate-blogs-feed.mjs",
    "build": "next build",
    "postbuild": "node scripts/assert-no-gundem-links.mjs",
    "test:unit": "node --import tsx --test app/lib/content-safety.test.ts app/lib/image-license.test.ts scripts/lib/gundem-trends.test.ts scripts/lib/blog-queue-body.test.ts",
    "check:queues": "node --import tsx scripts/check-queue-safety.ts",
    "check:ops": "node --import tsx scripts/check-ops-phase0.ts",
    "check:measurement": "node --import tsx scripts/check-measurement-phase5.ts",
    "ops:collect": "node --import tsx scripts/collect-ops-baseline.ts",
    "ops:fetch-gsc": "node --import tsx scripts/fetch-gsc-performance-export.ts",
    "ops:merge-gsc-demand": "node --import tsx scripts/merge-gsc-demand-signals.ts",
    "ops:gsc-sync": "node --import tsx scripts/fetch-gsc-performance-export.ts && node --import tsx scripts/merge-gsc-demand-signals.ts",
    "ops:import-gsc-baseline": "node --import tsx scripts/import-gsc-baseline-snapshot.ts",
    "verify:prod": "pnpm check:ops && pnpm check:measurement && pnpm check:queues && pnpm gundem:smoke-prod",
    "ops:prune-deployments": "node --import tsx scripts/vercel-prune-deployments.ts",
    "blog-queue:sync": "python3 scripts/_write_sept_blog_queue.py",
    "gundem:seed-blob": "node --import tsx scripts/seed-gundem-blob.ts",
    "gundem:verify-blob": "node --import tsx scripts/verify-gundem-blob.ts",
    "gundem:refresh-queue": "node --import tsx scripts/refresh-gundem-queue.ts",
    "gundem:publish": "node --import tsx scripts/refresh-gundem-queue.ts && node --import tsx scripts/publish-gundem.ts",
    "gundem:smoke-prod": "node --import tsx scripts/gundem-smoke-prod.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "newsletter:send": "pnpm dlx tsx scripts/send-blog-newsletter.ts",
    "newsletter:sync": "pnpm dlx tsx scripts/send-blog-newsletter.ts --sync",
    "blog:publish": "node scripts/publish-daily-blog.mjs",
    "blog:publish:dry": "node scripts/publish-daily-blog.mjs --dry-run",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "playwright test --project=webkit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "^2.0.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-github-calendar": "5.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9"
  }
}
