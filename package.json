{
  "name": "berktug-portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/generate-blogs-feed.mjs",
    "build": "next build",
    "postbuild": "node scripts/validate-project-i18n.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "newsletter:send": "pnpm dlx tsx scripts/send-blog-newsletter.ts",
    "newsletter:sync": "pnpm dlx tsx scripts/send-blog-newsletter.ts --sync"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "lucide-react": "^0.542.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-github-calendar": "5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9"
  }
}
